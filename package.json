{
  "name": "100-veces-tu-y-yo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "catalog:check": "node scripts/validate-catalog.mjs",
    "db:check": "node scripts/check-rls.mjs",
    "catalog:filters": "node scripts/test-catalog-filters.mjs",
    "experience:check": "node scripts/test-experience-content.mjs",
    "invite:check": "node scripts/test-invite-code.mjs",
    "join:check": "node scripts/test-join-circle.mjs",
    "planning:errors:check": "node scripts/test-planning-errors.mjs",
    "auth:errors:check": "node scripts/test-auth-errors.mjs",
    "staging:auth:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-auth-rls.ps1",
    "staging:ui-fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-mobile-users.ps1 ui-fixture",
    "staging:experience:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-mobile-users.ps1 experience",
    "staging:memories:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-mobile-users.ps1 memories",
    "staging:circle-join:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-mobile-users.ps1 circle-join",
    "staging:memories:browser-fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-staging-mobile-users.ps1 browser-fixture"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.67.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
